{
  "manifest_version": 3,
  "name": "YouTube Lyrics",
  "version": "2.0.0",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://your-backend-domain.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" }
}